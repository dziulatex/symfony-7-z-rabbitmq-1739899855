<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Welcome!{% endblock %}</title>

    {# Bootstrap CSS #}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    {# Optional custom CSS block #}
    {% block stylesheets %}{% endblock %}
</head>
<body>
{# Navigation #}
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="{{ path('file_upload_form') }}">File Upload System</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav">
                <li class="nav-item {% if app.request.attributes.get('_route') == 'file_upload_form' %}active{% endif %}">
                    <a class="nav-link" href="{{ path('file_upload_form') }}">Upload</a>
                </li>
                <li class="nav-item {% if app.request.attributes.get('_route') == 'upload_from_url_form' %}active{% endif %}">
                    <a class="nav-link" href="{{ path('upload_from_url_form') }}">Upload from URL</a>
                </li>
                <li class="nav-item {% if app.request.attributes.get('_route') == 'file_list_form' %}active{% endif %}">
                    <a class="nav-link" href="{{ path('file_list_form') }}">File List</a>
                </li>
                <li class="nav-item {% if app.request.attributes.get('_route') == 'app_clients_list' %}active{% endif %}">
                    <a class="nav-link" href="{{ path('app_clients_list') }}">Client List</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

{# Main content #}
<main>
    {% block body %}{% endblock %}
</main>

{# Footer #}
<footer class="footer mt-auto py-3 bg-light">
    <div class="container text-center">
        <span class="text-muted">© {{ "now"|date("Y") }} File Upload System</span>
    </div>
</footer>

{# Bootstrap JS with Popper #}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

{# Optional custom JavaScript block #}
{% block javascripts %}{% endblock %}
</body>
</html>