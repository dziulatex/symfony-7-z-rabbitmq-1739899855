{% extends 'base.html.twig' %}

{% block title %}File List{% endblock %}

{% block body %}
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>File List</h1>
            <div>
                <a href="{{ path('file_upload_form') }}" class="btn btn-primary">
                    <i class="bi bi-upload"></i> Upload New File
                </a>
            </div>
        </div>

        {# Filter Form #}
        <div class="card mb-4">
            <div class="card-header bg-light">
                <h5 class="card-title mb-0">Filters</h5>
            </div>
            <div class="card-body">
                <form method="get" class="row g-3">
                    <div class="col-md-3">
                        <label for="filename" class="form-label">Filename</label>
                        <input type="text" class="form-control" id="filename" name="filename"
                               value="{{ app.request.query.get('filename') }}" placeholder="Search by filename">
                    </div>
                    <div class="col-md-3">
                        <label for="startDate" class="form-label">Start Date</label>
                        <input type="date" class="form-control" id="startDate" name="startDate"
                               value="{{ app.request.query.get('startDate') }}">
                    </div>
                    <div class="col-md-3">
                        <label for="endDate" class="form-label">End Date</label>
                        <input type="date" class="form-control" id="endDate" name="endDate"
                               value="{{ app.request.query.get('endDate') }}">
                    </div>
                    <div class="col-md-3">
                        <label for="path" class="form-label">Path</label>
                        <input type="text" class="form-control" id="path" name="path"
                               value="{{ app.request.query.get('path') }}" placeholder="Search by path">
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary me-2">
                            <i class="bi bi-search"></i> Apply Filters
                        </button>
                        <a href="{{ path('file_list_form') }}" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Clear Filters
                        </a>
                    </div>
                </form>
            </div>
        </div>

        {# Results Summary #}
        <div class="alert alert-info d-flex justify-content-between align-items-center">
            <div>
                Found {{ totalItems }} file(s)
                {% if app.request.query.all|length > 0 %}
                    with current filters
                {% endif %}
            </div>
            <div class="text-muted">
                Showing {{ min(perPage, files|length) }} files per page
            </div>
        </div>

        {# Files Table #}
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0">
                        <thead class="table-light">
                        <tr>
                            <th>Filename</th>
                            <th>Path</th>
                            <th>Upload Date</th>
                            <th>MD5 Hash</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for file in files %}
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-file-earmark me-2"></i>
                                        {{ file.filename }}
                                    </div>
                                </td>
                                <td>
                                    <small class="text-muted">{{ file.path }}</small>
                                </td>
                                <td>
                                    <div title="{{ file.uploadedAt|date('Y-m-d H:i:s') }}">
                                        {{ file.uploadedAt|date('d M Y H:i') }}
                                    </div>
                                </td>
                                <td>
                                    <code class="small">{{ file.md5Hash }}</code>
                                </td>
                                <td>
                                    {% set statusClass = {
                                        'new': 'secondary',
                                        'waiting': 'info',
                                        'processing': 'warning',
                                        'processed': 'success',
                                        'error': 'danger'
                                    } %}
                                    {% set statusIcon = {
                                        'new': 'file-earmark',
                                        'waiting': 'hourglass-split',
                                        'processing': 'arrow-repeat',
                                        'processed': 'check-circle',
                                        'error': 'exclamation-circle'
                                    } %}
                                    <div class="status-container">
                                    <span class="badge bg-{{ statusClass[file.state.value] }} mb-2">
                                        <i class="bi bi-{{ statusIcon[file.state.value] }}"></i>
                                        {{ file.state.value }}
                                        {% if file.errorMessage %}
                                            <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip"
                                               data-bs-placement="top" title="{{ file.errorMessage }}"></i>
                                        {% endif %}
                                    </span>

                                        {# Refresh Animation Container #}
                                        <div class="refresh-animation-container" style="height: 4px; display:none">
                                            <div class="refresh-animation-bar"></div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        <button type="button" class="btn btn-sm btn-outline-primary js-parse-file-btn"
                                                data-file-id="{{ file.id }}" data-file-state="{{ file.state.value }}"
                                                data-csrf-token="{{ csrf_token('parse_file_' ~ file.id) }}"
                                                {{ file.state.value not in ['new', 'error', 'waiting'] ? 'disabled' : '' }}>
                                            {% if file.state.value == 'new' %}
                                                <i class="bi bi-file-earmark-text"></i> Parse
                                            {% elseif file.state.value == 'waiting' %}
                                                <i class="bi bi-hourglass-split"></i> Waiting...
                                            {% elseif file.state.value == 'processing' %}
                                                <i class="bi bi-arrow-repeat"></i> Processing...
                                            {% elseif file.state.value == 'error' %}
                                                <i class="bi bi-arrow-clockwise"></i> Retry
                                            {% else %}
                                                <i class="bi bi-check-circle"></i> Processed
                                            {% endif %}
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center py-4">
                                    <div class="text-muted">
                                        <i class="bi bi-inbox fs-4 d-block mb-2"></i>
                                        No files found
                                        {% if app.request.query.all|length > 0 %}
                                            with current filters
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        {# Pagination #}
        {% if lastPage > 1 %}
            <div class="mt-4">
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center">
                        {# Previous Page #}
                        <li class="page-item {{ currentPage == 1 ? 'disabled' }}">
                            <a class="page-link"
                               href="{{ path('file_list_form', app.request.query.all|merge({'page': currentPage - 1})) }}"
                               aria-label="Previous">
                                <span aria-hidden="true">«</span>
                            </a>
                        </li>

                        {# First Page #}
                        {% if currentPage > 3 %}
                            <li class="page-item">
                                <a class="page-link"
                                   href="{{ path('file_list_form', app.request.query.all|merge({'page': 1})) }}">1</a>
                            </li>
                            {% if currentPage > 4 %}
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            {% endif %}
                        {% endif %}

                        {# Page Numbers #}
                        {% for i in max(1, currentPage - 2)..min(lastPage, currentPage + 2) %}
                            <li class="page-item {{ currentPage == i ? 'active' }}">
                                <a class="page-link"
                                   href="{{ path('file_list_form', app.request.query.all|merge({'page': i})) }}">{{ i }}</a>
                            </li>
                        {% endfor %}

                        {# Last Page #}
                        {% if currentPage < lastPage - 2 %}
                            {% if currentPage < lastPage - 3 %}
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            {% endif %}
                            <li class="page-item">
                                <a class="page-link"
                                   href="{{ path('file_list_form', app.request.query.all|merge({'page': lastPage})) }}">{{ lastPage }}</a>
                            </li>
                        {% endif %}

                        {# Next Page #}
                        <li class="page-item {{ currentPage == lastPage ? 'disabled' }}">
                            <a class="page-link"
                               href="{{ path('file_list_form', app.request.query.all|merge({'page': currentPage + 1})) }}"
                               aria-label="Next">
                                <span aria-hidden="true">»</span>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        .refresh-animation-container {
            position: relative;
            height: 4px; /*Match progress bar height */
            overflow: hidden; /*Hide overflow */
        }

        .refresh-animation-bar {
            width: 100%;
            height: 100%;
            background-color: #0d6efd; /*Or any color you like */
            animation: shrink 15s linear forwards; /*15s to match interval */
            transform-origin: left; /*Shrink from the left */
        }

        /*Initial animation */
        .refresh-animation-bar.initial {
            animation: shrink 2s linear forwards;
        }

        @keyframes shrink {
            0% {
                transform: scaleX(1); /*Full width */
            }
            100% {
                transform: scaleX(0); /*Zero width */
            }
        }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Initialize tooltips
        const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
        const tooltipList = [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));

        document.addEventListener('DOMContentLoaded', function () {
            const parseFileButtons = document.querySelectorAll('.js-parse-file-btn');
            const eventSources = {}; // Keep track of EventSources
            const statusCheckIntervals = {}; // Keep track of intervals
            const REFRESH_INTERVAL = 15000; // 15 seconds - CONSTANT
            const INITIAL_REFRESH_DELAY = 2000; // 2 seconds


            // --- Helper Functions ---

            // Fetch file status (used by interval)
            async function refreshFileState(fileId, button) {
                try {
                    const response = await fetch(`/api/file/status/${fileId}`, {
                        method: 'GET',
                        headers: {
                            'Accept': 'application/json'
                        }
                    });

                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }

                    const data = await response.json();
                    if (data.success) {
                        const status = data.data.status.toLowerCase();
                        const progress = data.data.progress;
                        const errorMessage = data.data.errorMessage;
                        updateButtonAndStatus(button, status, progress, errorMessage);
                        return status;
                    } else {
                        throw new Error(data.message || 'Failed to get file status');
                    }
                } catch (error) {
                    console.error('Refresh state error:', error);
                    updateButtonAndStatus(button, 'error', null, 'Failed to refresh status');
                    return 'error';
                }
            }

            function clearFileInterval(fileId) {
                if (statusCheckIntervals[fileId]) {
                    clearInterval(statusCheckIntervals[fileId]);
                    delete statusCheckIntervals[fileId];
                }
            }

            // Update button and status display (centralized logic)
            function updateButtonAndStatus(button, state, progress = null, errorMessage = null) {
                const fileId = button.dataset.fileId;
                const states = {
                    'new': {
                        text: '<i class="bi bi-file-earmark-text"></i> Parse',
                        disabled: false,
                        badgeClass: 'secondary',
                        badgeIcon: 'file-earmark'
                    },
                    'waiting': {
                        text: '<i class="bi bi-hourglass-split"></i> Waiting...',
                        disabled: true,
                        badgeClass: 'info',
                        badgeIcon: 'hourglass-split'
                    },
                    'processing': {
                        text: '<i class="bi bi-arrow-repeat"></i> Processing...',
                        disabled: true,
                        badgeClass: 'warning',
                        badgeIcon: 'arrow-repeat'
                    },
                    'processed': {
                        text: '<i class="bi bi-check-circle"></i> Processed',
                        disabled: true,
                        badgeClass: 'success',
                        badgeIcon: 'check-circle'
                    },
                    'error': {
                        text: '<i class="bi bi-arrow-clockwise"></i> Retry',
                        disabled: false,
                        badgeClass: 'danger',
                        badgeIcon: 'exclamation-circle'
                    }
                };

                const stateInfo = states[state];
                button.innerHTML = stateInfo.text;
                button.disabled = stateInfo.disabled;
                button.dataset.fileState = state;

                const row = button.closest('tr');
                const statusCell = row.querySelector('td:nth-last-child(2)');
                const statusContainer = statusCell.querySelector('.status-container');
                const badge = statusContainer.querySelector('.badge');
                badge.className = `badge bg-${stateInfo.badgeClass} mb-2`;

                let badgeContent = `<i class="bi bi-${stateInfo.badgeIcon}"></i> ${state}`;
                if (errorMessage) {
                    badgeContent += ` <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top" title="${errorMessage}"></i>`;
                }
                badge.innerHTML = badgeContent;

                // Re-initialize tooltips
                if (errorMessage) {
                    const tooltipTriggerList = statusContainer.querySelectorAll('[data-bs-toggle="tooltip"]');
                    tooltipTriggerList.forEach(el => new bootstrap.Tooltip(el));
                }

                // Progress bar logic
                let progressBar = statusContainer.querySelector('.progress');
                if (state === 'processing') {
                    if (!progressBar) {
                        progressBar = document.createElement('div');
                        progressBar.className = 'progress';
                        progressBar.style.height = '4px';
                        progressBar.innerHTML = `<div class="progress-bar progress-bar-striped progress-bar-animated ${state === 'waiting' ? 'bg-info' : 'bg-warning'}" role="progressbar" style="width: ${state === 'waiting' ? '100' : '0'}%;" aria-valuenow="${state === 'waiting' ? '100' : '0'}" aria-valuemin="0" aria-valuemax="100"></div>`;
                        statusContainer.appendChild(progressBar);
                    }
                    if (progress !== null) {
                        const progressBarInner = progressBar.querySelector('.progress-bar');
                        const progressValue = progress;
                        progressBarInner.style.width = `${progressValue}%`;
                        progressBarInner.setAttribute('aria-valuenow', progressValue);
                        badge.innerHTML = `<i class="bi bi-${stateInfo.badgeIcon}"></i> ${state} (${progressValue}%)`;
                    }
                } else if (progressBar) {
                    progressBar.remove();
                }
                // Refresh animation logic (ONLY for 'waiting' state)
                let animationContainer = statusContainer.querySelector('.refresh-animation-container');

                if (state === 'waiting') {
                    animationContainer.style.display = 'block';
                    // Set initial animation class if needed
                    const animationBar = animationContainer.querySelector('.refresh-animation-bar');
                    if (button.hasAttribute('data-initial-animation')) {
                        animationBar.classList.add('initial');
                        button.removeAttribute('data-initial-animation'); // Remove after applying
                    } else {
                        animationBar.classList.remove('initial');
                    }

                } else {
                    animationContainer.style.display = 'none'; // Hide for other states
                }

            }

            // Start EventSource (only when transitioning to processing)
            function startEventSource(fileId, button) {
                clearFileInterval(fileId);
                if (eventSources[fileId]) {
                    eventSources[fileId].close();
                }

                setTimeout(() => {
                    const eventSource = new EventSource(`/api/file/status/${fileId}`);
                    eventSources[fileId] = eventSource;

                    eventSource.onmessage = (event) => {
                        try {
                            const data = JSON.parse(event.data);
                            if (data.success) {
                                const status = data.data.status.toLowerCase();
                                const progress = data.data.progress;
                                const errorMessage = data.data.errorMessage;
                                updateButtonAndStatus(button, status, progress, errorMessage);

                                if (status === 'processed' || status === 'error') {
                                    eventSource.close();
                                    delete eventSources[fileId];
                                }
                            } else {
                                throw new Error(data.message || 'EventSource data error');
                            }
                        } catch (error) {
                            console.error('Error processing SSE message:', error);
                            updateButtonAndStatus(button, 'error', null, 'Failed to process server response');
                            eventSource.close();
                            delete eventSources[fileId];
                        }
                    };

                    eventSource.onerror = (error) => {
                        console.error('SSE Error:', error);
                        updateButtonAndStatus(button, 'error', null, 'Lost connection to server');
                        eventSource.close();
                        delete eventSources[fileId];
                    };
                }, 1000);
            }

            // --- Event Handlers ---
            function setupInitialWaitingInterval(button, fileId) {
                const statusContainer = button.closest('tr').querySelector('.status-container');
                const animationBar = statusContainer.querySelector('.refresh-animation-bar');

                if (!animationBar) {
                    console.warn(`Animation bar not found for fileId: ${fileId}`);
                    return;
                }

                function restartAnimation() {
                    animationBar.style.animation = 'none'; // Remove existing animation
                    animationBar.offsetHeight; // Trigger reflow to restart animation
                    animationBar.style.animation = `shrink ${REFRESH_INTERVAL / 1000}s linear forwards`;
                }

                restartAnimation();


                const intervalId = setInterval(async () => {
                    const currentStatus = await refreshFileState(fileId, button);
                    if (currentStatus === 'processing') {
                        startEventSource(fileId, button);
                        clearFileInterval(fileId);
                    } else if (currentStatus === 'waiting') {
                        restartAnimation();
                    } else {
                        clearFileInterval(fileId);
                    }
                }, REFRESH_INTERVAL);

                statusCheckIntervals[fileId] = intervalId;
            }

            parseFileButtons.forEach(button => {

                button.addEventListener('click', async function () {
                    const fileId = this.dataset.fileId;
                    const csrfToken = this.dataset.csrfToken;
                    const parseUrl = `{{ path('parse_file', {'fileId': '__fileId__'}) }}`.replace('__fileId__', fileId);

                    try {
                        // Set a flag to indicate initial animation is needed
                        this.setAttribute('data-initial-animation', 'true');
                        updateButtonAndStatus(this, 'waiting');

                        const response = await fetch(parseUrl, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded',
                                'X-CSRF-Token': csrfToken
                            }
                        });

                        if (!response.ok) {
                            throw new Error(`HTTP error! status: ${response.status}`);
                        }

                        const data = await response.json();
                        if (data.success) {
                            // Initial refresh after a short delay.
                            setTimeout(async () => {
                                const status = await refreshFileState(fileId, this);
                                if (status === 'waiting') {
                                    setupInitialWaitingInterval(this, fileId);
                                } else if (status === 'processing') {
                                    startEventSource(fileId, this);
                                }
                            }, INITIAL_REFRESH_DELAY);

                        } else {
                            updateButtonAndStatus(this, 'error', null, data.message || 'Failed to start processing');
                        }
                    } catch (error) {
                        console.error('Fetch error:', error);
                        updateButtonAndStatus(this, 'error', null, 'Network error occurred');
                    }
                });
                // Initial setup when page loads
                if (button.dataset.fileState === 'waiting') {
                    //setupInitialWaitingInterval(button, button.dataset.fileId);
                    updateButtonAndStatus(button, 'waiting'); // Ensure correct initial display
                } else if (button.dataset.fileState === 'processing') {
                    startEventSource(button.dataset.fileId, button);
                } else {
                    updateButtonAndStatus(button, button.dataset.fileState);
                }

            });


            // --- Cleanup ---
            window.addEventListener('beforeunload', () => {
                Object.values(eventSources).forEach(es => es.close());
                Object.values(statusCheckIntervals).forEach(intervalId => clearInterval(intervalId));
            });
        });
    </script>
{% endblock %}