{% extends 'base.html.twig' %}

{% block title %}Upload from URL{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <h1 class="h3 mb-0">Upload CSV from URL</h1>
                    </div>
                    <div class="card-body">
                        <form id="urlUploadForm">
                            <div class="mb-3">
                                <label for="url" class="form-label">URL address</label>
                                <input type="url"
                                       class="form-control"
                                       id="url"
                                       name="url"
                                       required
                                       placeholder="https://example.com/data.csv">
                                <div class="form-text">Enter the URL of the CSV file you want to upload</div>
                            </div>
                            <button type="submit" class="btn btn-primary">Upload</button>
                        </form>

                        <div id="uploadStatus" class="alert mt-3" style="display: none;"></div>
                    </div>
                </div>

                {% for message in app.flashes('success') %}
                    <div class="alert alert-success mt-3">
                        {{ message }}
                    </div>
                {% endfor %}

                {% for message in app.flashes('error') %}
                    <div class="alert alert-danger mt-3">
                        {{ message }}
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        document.getElementById('urlUploadForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const statusDiv = document.getElementById('uploadStatus');
            const submitButton = this.querySelector('button[type="submit"]');
            const url = document.getElementById('url').value;

            // Disable button and show loading state
            submitButton.disabled = true;
            submitButton.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Uploading...';

            try {
                const response = await fetch('{{ path('upload_from_url') }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ url: url })
                });

                const data = await response.json();

                statusDiv.className = `alert ${data.success ? 'alert-success' : 'alert-danger'}`;
                statusDiv.textContent = data.message;
                statusDiv.style.display = 'block';

                if (data.success) {
                    document.getElementById('url').value = '';
                }
            } catch (error) {
                statusDiv.className = 'alert alert-danger';
                statusDiv.textContent = 'An error occurred while uploading the file';
                statusDiv.style.display = 'block';
            } finally {
                // Reset button state
                submitButton.disabled = false;
                submitButton.innerHTML = 'Upload';
            }
        });
    </script>
{% endblock %}