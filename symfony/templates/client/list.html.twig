{# templates/client/list.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Client List{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .table-responsive {
            overflow-x: auto;
        }

        .pagination {
            justify-content: center;
            margin-top: 20px;
        }

        .page-item.active .page-link {
            background-color: #007bff;
            border-color: #007bff;
            color: white;
        }

        .page-link {
            color: #007bff;
            border: 1px solid #dee2e6;
            padding: .375rem .75rem;
            margin: 0 .25rem;
            border-radius: .25rem;
            text-decoration: none;
            /* Remove underlines from links */
        }

        .page-link:hover {
            background-color: #e9ecef;
            color: black;
        }

        .filter-form {
            margin-bottom: 20px;
            border: 1px solid #dee2e6;
            padding: 15px;
            border-radius: .25rem;
        }

        .error-link {
            margin-left: 10px; /* Add some space between filename and button */
        }
        .download-button-container{
            display: flex;
            align-items: center; /* Vertically center items */

        }
    </style>
{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>Client List</h1>

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger">
                {{ message }}
            </div>
        {% endfor %}

        <div class="filter-form">
            <form method="get" action="{{ path('app_clients_list') }}" class="row g-3 align-items-center">
                <div class="col-auto">
                    <label for="fileUploadId" class="form-label visually-hidden">Select File:</label>
                    <div class="download-button-container">  {# Container for select and button #}
                        <select name="fileUploadId" id="fileUploadId" class="form-select" onchange="this.form.submit()">
                            <option value="">-- All Files --</option>
                            {% for fileUpload in fileUploads %}
                                <option value="{{ fileUpload.id }}" {% if selectedFileUpload and selectedFileUpload.id==
                                    fileUpload.id %}selected{% endif %}>
                                    {{ fileUpload.filename }} ({{ fileUpload.uploadedAt|date('Y-m-d H:i:s') }})
                                </option>
                            {% endfor %}
                        </select>

                        {% if selectedFileUpload %}
                            <a href="{{ path('app_clients_download_errors', {'fileUploadId': selectedFileUpload.id}) }}"
                               class="btn btn-sm btn-warning error-link" title="Download Error File">
                                Errors
                            </a>
                        {% endif %}
                    </div>
                </div>
                <div class="col-auto">
                    <input type="hidden" name="page" value="{{ currentPage }}">
                </div>
            </form>
        </div>

        {% if clients is empty %}
            <div class="alert alert-info" role="alert">
                No clients found{% if selectedFileUpload %} for file: <strong>{{ selectedFileUpload.filename
                }}</strong>{% endif %}.
            </div>
        {% else %}
            <p>
                Total Clients: <strong>{{ totalCount }}</strong>
                {% if selectedFileUpload %}, associated with: <strong>{{ selectedFileUpload.filename }}</strong>{% endif %}
            </p>

            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                    <tr>
                        <th scope="col">ID</th>
                        <th scope="col">Full Name</th>
                        <th scope="col">Email</th>
                        <th scope="col">City</th>
                        <th scope="col">File Upload</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for client in clients %}
                        <tr>
                            <td>{{ client.id }}</td>
                            <td>{{ client.fullName }}</td>
                            <td><a href="mailto:{{ client.email }}">{{ client.email }}</a></td>
                            <td>{{ client.city }}</td>
                            <td>
                                {% if client.fileUpload %}
                                    {{ client.fileUpload.filename }}
                                {% else %}
                                    <span class="badge bg-secondary">No File</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>

            <nav aria-label="Page navigation">
                <ul class="pagination">
                    {# ... (your pagination code) ... #}
                    {% if currentPage > 1 %}
                        <li class="page-item">
                            <a class="page-link"
                               href="{{ path('app_clients_list', {'fileUploadId': selectedFileUpload ? selectedFileUpload.id, 'page': currentPage - 1}) }}"
                               aria-label="Previous">
                                <span aria-hidden="true">«</span>
                                <span class="visually-hidden">Previous</span>
                            </a>
                        </li>
                    {% endif %}

                    {% set totalPages = (totalCount / limit)|round(0, 'ceil') %}
                    {% set startPage = (currentPage - 20) > 0 ? (currentPage - 20) : 1 %}
                    {% set endPage = (currentPage + 20) < totalPages ? (currentPage + 20) : totalPages %}


                    {% for i in startPage..endPage %}
                        <li class="page-item {% if i == currentPage %}active{% endif %}">
                            <a class="page-link"
                               href="{{ path('app_clients_list', {'fileUploadId': selectedFileUpload ? selectedFileUpload.id, 'page': i}) }}">{{
                                i }}</a>
                        </li>
                    {% endfor %}

                    {% if currentPage < totalPages %}
                        <li class="page-item">
                            <a class="page-link"
                               href="{{ path('app_clients_list', {'fileUploadId': selectedFileUpload ? selectedFileUpload.id, 'page': currentPage + 1}) }}"
                               aria-label="Next">
                                <span aria-hidden="true">»</span>
                                <span class="visually-hidden">Next</span>
                            </a>
                        </li>
                    {% endif %}
                </ul>
            </nav>
        {% endif %}
    </div>
{% endblock %}